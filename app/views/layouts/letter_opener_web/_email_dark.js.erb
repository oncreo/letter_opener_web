// Recolours an email for dark mode the way Outlook and Gmail do, rather than
// inverting the whole page: light backgrounds become dark, dark text becomes
// light, hues are kept, and images are left alone. Colours are adjusted in
// OKLCH so a brand blue stays the same blue, just lighter or darker.
var EmailDark = (function () {
  'use strict';

  var CANVAS_L = 0.26;        // white page -> about #212121
  var BG_THRESHOLD = 0.55;    // backgrounds lighter than this get darkened...
  var VIVID_CHROMA = 0.1;     // ...unless they're a strong colour, like a button
  var TEXT_THRESHOLD = 0.6;   // text darker than this gets lightened
  var MIN_CONTRAST = 0.4;     // minimum lightness gap between text and its background
  var SIDES = ['top', 'right', 'bottom', 'left'];
  var SKIP = /^(img|svg|video|picture|canvas|iframe|object|embed|script|style|head|meta|link|title|base|br|wbr)$/i;

  function parse(value) {
    var m = /^rgba?\(\s*([\d.]+)[,\s]+([\d.]+)[,\s]+([\d.]+)(?:\s*[,/]\s*([\d.]+)(%?))?\s*\)$/.exec(value || '');
    if (!m) return null;
    var alpha = m[4] === undefined ? 1 : parseFloat(m[4]) / (m[5] ? 100 : 1);
    return { r: m[1] / 255, g: m[2] / 255, b: m[3] / 255, a: alpha };
  }

  function linear(c) { return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); }
  function gamma(c) { return c <= 0.0031308 ? 12.92 * c : 1.055 * Math.pow(c, 1 / 2.4) - 0.055; }

  function toLch(c) {
    var r = linear(c.r), g = linear(c.g), b = linear(c.b);
    var l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);
    var m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);
    var s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);
    var A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s;
    var B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s;
    return { L: 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s, C: Math.sqrt(A * A + B * B), h: Math.atan2(B, A), a: c.a };
  }

  function toCss(L, C, h, alpha) {
    var rgb;
    // Pull chroma in until the colour fits in sRGB.
    for (var i = 0; i < 24; i++) {
      var A = C * Math.cos(h), B = C * Math.sin(h);
      var l = Math.pow(L + 0.3963377774 * A + 0.2158037573 * B, 3);
      var m = Math.pow(L - 0.1055613458 * A - 0.0638541728 * B, 3);
      var s = Math.pow(L - 0.0894841775 * A - 1.2914855480 * B, 3);
      rgb = [
        4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
      ];
      if (rgb.every(function (v) { return v >= -0.0005 && v <= 1.0005; })) break;
      C *= 0.85;
    }
    var out = rgb.map(function (v) { return Math.round(gamma(Math.min(1, Math.max(0, v))) * 255); });
    return alpha < 1 ? 'rgba(' + out.join(', ') + ', ' + alpha + ')' : 'rgb(' + out.join(', ') + ')';
  }

  function darkenBackground(lightness) { return CANVAS_L + (1 - lightness) * 0.35; }

  function apply(doc) {
    var win = doc.defaultView;
    var root = doc.documentElement;
    var plan = [];

    // Read everything first: writing as we go would change what children inherit.
    (function read(el, parentBgL, overImage) {
      if (SKIP.test(el.tagName)) return;

      var style = win.getComputedStyle(el);
      var change = { el: el, borders: [] };
      var bgL = parentBgL;
      var image = overImage;
      var bg = parse(style.backgroundColor);
      var hasImage = style.backgroundImage && style.backgroundImage !== 'none';

      if (bg && bg.a > 0.05) {
        var b = toLch(bg);
        bgL = b.L;
        if (b.L > BG_THRESHOLD && b.C < VIVID_CHROMA) {
          bgL = darkenBackground(b.L);
          change.bg = toCss(bgL, b.C * 0.7, b.h, bg.a);
        }
        image = hasImage;
      } else if (el === root) {
        bgL = CANVAS_L;
        change.bg = toCss(CANVAS_L, 0, 0, 1);
      } else if (hasImage) {
        image = true;
      }

      // Text keeps its colour over a background image (we can't see what's behind
      // it) and over a light background we left alone, like a yellow button.
      var fg = parse(style.color);
      if (fg && !image && bgL <= BG_THRESHOLD) {
        var f = toLch(fg);
        var L = f.L < TEXT_THRESHOLD ? 0.93 - f.L * 0.35 : f.L;
        if (L - bgL < MIN_CONTRAST) L = Math.min(0.97, bgL + 0.45);
        if (Math.abs(L - f.L) > 0.005) change.color = toCss(L, Math.min(f.C, 0.16), f.h, fg.a);
      }

      SIDES.forEach(function (side) {
        if (style.getPropertyValue('border-' + side + '-style') === 'none') return;
        if (!(parseFloat(style.getPropertyValue('border-' + side + '-width')) > 0)) return;
        var c = parse(style.getPropertyValue('border-' + side + '-color'));
        if (!c || c.a === 0) return;
        var lch = toLch(c);
        if (lch.L > BG_THRESHOLD) change.borders.push([side, toCss(darkenBackground(lch.L) + 0.08, lch.C * 0.7, lch.h, c.a)]);
        else if (lch.L < 0.3) change.borders.push([side, toCss(0.45, lch.C, lch.h, c.a)]);
      });

      if (change.bg || change.color || change.borders.length) plan.push(change);
      for (var child = el.firstElementChild; child; child = child.nextElementSibling) read(child, bgL, image);
    })(root, CANVAS_L, false);

    plan.forEach(function (change) {
      var s = change.el.style;
      if (change.bg) s.setProperty('background-color', change.bg, 'important');
      if (change.color) s.setProperty('color', change.color, 'important');
      change.borders.forEach(function (b) { s.setProperty('border-' + b[0] + '-color', b[1], 'important'); });
    });
    root.style.setProperty('color-scheme', 'dark');
  }

  // Turns on the email's own @media (prefers-color-scheme: dark) rules, the way
  // Apple Mail does. Returns false when the email doesn't have any.
  function applyNative(doc) {
    var found = 0;
    Array.prototype.forEach.call(doc.styleSheets, function (sheet) {
      var rules;
      try { rules = sheet.cssRules; } catch (e) { return; }
      var dark = [];
      Array.prototype.forEach.call(rules, function (rule) {
        if (rule.media && /prefers-color-scheme\s*:\s*dark/i.test(rule.media.mediaText)) {
          Array.prototype.forEach.call(rule.cssRules, function (inner) { dark.push(inner.cssText); });
        }
      });
      dark.forEach(function (text) {
        try { sheet.insertRule(text, sheet.cssRules.length); found++; } catch (e) { /* unsupported rule */ }
      });
    });
    doc.documentElement.style.setProperty('color-scheme', 'dark');
    return found > 0;
  }

  return { apply: apply, applyNative: applyNative };
})();
