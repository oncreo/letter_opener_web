<%= tag.style nonce: lo_nonce do %>
  :root {
    --bg: #f6f7f9;
    --surface: #ffffff;
    --surface-2: #f1f3f6;
    --hover: #eef1f5;
    --border: #e3e6eb;
    --text: #1d2330;
    --muted: #6b7385;
    --accent: #4f46e5;
    --accent-soft: #eceafd;
    --accent-text: #3730a3;
    --danger: #d92d20;
    --danger-soft: #fdecea;
    --radius: 8px;
    --sidebar: 360px;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    color-scheme: light;
  }

  :root[data-theme="dark"] {
    --bg: #0f1115;
    --surface: #171a21;
    --surface-2: #1e222b;
    --hover: #222733;
    --border: #2a2f3a;
    --text: #e6e9ef;
    --muted: #8d95a5;
    --accent: #8b85ff;
    --accent-soft: #2a2850;
    --accent-text: #c7c4ff;
    --danger: #ff6b5f;
    --danger-soft: #3a1d1b;
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body { height: 100%; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 14px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  [hidden] { display: none !important; }
  button { font: inherit; color: inherit; }
  .muted { color: var(--muted); }
  .icon { flex: none; display: block; }
  .inline { display: inline; margin: 0; }

  .app {
    display: grid;
    grid-template-columns: var(--sidebar) minmax(0, 1fr);
    height: 100vh;
    height: 100dvh;
  }

  /* Sidebar */

  .sidebar {
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: var(--surface);
    border-right: 1px solid var(--border);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 12px 10px 16px;
  }

  .title { display: flex; align-items: center; gap: 8px; color: var(--accent); }
  .title h1 { margin: 0; font-size: 17px; font-weight: 650; color: var(--text); letter-spacing: -.01em; }

  .count {
    min-width: 22px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    text-align: center;
  }

  .env {
    padding: 0 6px;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--muted);
    font-size: 11px;
    font-weight: 600;
    line-height: 18px;
  }

  .env-production { border-color: var(--danger); color: var(--danger); }

  .actions { display: flex; align-items: center; gap: 2px; }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    text-decoration: none;
  }

  .icon-button:hover { background: var(--hover); color: var(--text); }
  .icon-button.danger:hover { background: var(--danger-soft); color: var(--danger); }
  .icon-button:focus-visible, .segmented button:focus-visible, .item-link:focus-visible, .search input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  [data-theme-icon] { display: none; }
  [data-theme-pref="system"] [data-theme-icon="system"],
  [data-theme-pref="light"] [data-theme-icon="light"],
  [data-theme-pref="dark"] [data-theme-icon="dark"] { display: block; }

  .refreshing [data-action="refresh"] .icon { animation: spin .8s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    margin: 0 12px 10px;
    color: var(--muted);
  }

  .search .icon { position: absolute; left: 10px; pointer-events: none; }

  .search input {
    width: 100%;
    height: 34px;
    padding: 0 30px 0 32px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text);
    font: inherit;
  }

  .search input::placeholder { color: var(--muted); }
  .search input:focus { background: var(--surface); }
  .search input::-webkit-search-cancel-button { display: none; }

  kbd {
    position: absolute;
    right: 8px;
    padding: 0 5px;
    border: 1px solid var(--border);
    border-radius: 4px;
    font: 11px/16px var(--mono);
    color: var(--muted);
  }

  .search input:focus ~ kbd { display: none; }

  .list { flex: 1; overflow-y: auto; border-top: 1px solid var(--border); }
  .list ul { margin: 0; padding: 0; list-style: none; }

  .item { position: relative; border-bottom: 1px solid var(--border); }

  .item-link {
    display: flex;
    gap: 12px;
    padding: 12px 14px 12px 16px;
    color: inherit;
    text-decoration: none;
  }

  .item:hover { background: var(--hover); }
  .item.active { background: var(--accent-soft); }
  .item.active::before {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--accent);
  }

  .item.unread .sender, .item.unread .subject { font-weight: 650; }
  .item.unread .item-top::after {
    content: "";
    order: -1;
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .item-body { display: flex; flex-direction: column; flex: 1; min-width: 0; gap: 1px; }
  .item-top { display: flex; align-items: center; gap: 6px; }
  .sender { flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .when { flex: none; color: var(--muted); font-size: 12px; }
  .subject { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 13.5px; }

  .preview {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    color: var(--muted);
    font-size: 12.5px;
  }

  .preview .icon { display: inline-block; vertical-align: -1px; margin-right: 2px; }

  .item-delete {
    position: absolute;
    right: 10px;
    bottom: 10px;
    width: 26px;
    height: 26px;
    border: 1px solid var(--border);
    background: var(--surface);
    opacity: 0;
  }

  .item:hover .item-delete, .item-delete:focus-visible { opacity: 1; }

  .list-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 48px 32px;
    color: var(--muted);
    text-align: center;
  }

  .avatar {
    --hue: 240;
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: hsl(var(--hue) 70% 92%);
    color: hsl(var(--hue) 55% 32%);
    font-weight: 650;
    font-size: 15px;
  }

  [data-theme="dark"] .avatar { background: hsl(var(--hue) 35% 24%); color: hsl(var(--hue) 80% 82%); }
  .hue-0 { --hue: 0; } .hue-1 { --hue: 30; } .hue-2 { --hue: 60; } .hue-3 { --hue: 90; }
  .hue-4 { --hue: 130; } .hue-5 { --hue: 165; } .hue-6 { --hue: 190; } .hue-7 { --hue: 215; }
  .hue-8 { --hue: 245; } .hue-9 { --hue: 275; } .hue-10 { --hue: 305; } .hue-11 { --hue: 335; }

  /* Reader */

  .reader { display: flex; min-width: 0; min-height: 0; }
  .letter { display: flex; flex-direction: column; flex: 1; min-width: 0; }

  .letter-header { padding: 20px 24px 14px; background: var(--surface); }
  .back { display: none; margin: -6px 0 6px -8px; }

  .letter-subject {
    margin: 0 0 14px;
    font-size: 20px;
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -.01em;
    overflow-wrap: anywhere;
  }

  .letter-meta { display: flex; align-items: flex-start; gap: 12px; }
  .letter-people { flex: 1; min-width: 0; }
  .from { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 8px; }
  .from .muted { font-size: 13px; }
  .letter-date { flex: none; font-size: 12.5px; padding-top: 2px; }

  .recipients {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0 8px;
    margin: 2px 0 0;
    font-size: 12.5px;
    color: var(--muted);
  }

  .recipients div { display: contents; }
  .recipients dt { font-weight: 600; }
  .recipients dd { margin: 0; color: var(--text); overflow-wrap: anywhere; }

  .attachments { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 0 48px; padding: 0; list-style: none; }

  .attachments a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    max-width: 280px;
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-2);
    color: var(--text);
    font-size: 12.5px;
    text-decoration: none;
  }

  .attachments a:hover { border-color: var(--accent); }
  .attachments .name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 16px 8px 24px;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .toolbar-group { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .toolbar-divider { width: 1px; height: 20px; margin: 0 2px; background: var(--border); }

  .segmented {
    display: inline-flex;
    padding: 2px;
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  .segmented button {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 28px;
    padding: 0 10px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    font-size: 12.5px;
    font-weight: 550;
    cursor: pointer;
    white-space: nowrap;
  }

  .segmented button:hover { color: var(--text); }
  .segmented button[aria-selected="true"], .segmented button[aria-pressed="true"] {
    background: var(--surface);
    border-color: var(--border);
    color: var(--text);
  }

  .viewport { position: relative; flex: 1; min-height: 0; overflow: auto; background: var(--bg); }

  .viewport iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #ffffff;
    transition: opacity .12s ease;
  }

  [data-theme="dark"] .viewport iframe { background: #1f1f1f; }
  .viewport iframe.loading { opacity: 0; transition: none; }

  .viewport.mobile { padding: 20px; }

  .viewport.mobile iframe {
    width: 375px;
    max-width: 100%;
    height: 100%;
    margin: 0 auto;
    border: 1px solid var(--border);
    border-radius: 18px;
  }

  .reader-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    flex: 1;
    gap: 6px;
    padding: 32px;
    color: var(--muted);
    text-align: center;
  }

  .reader-empty h2 { margin: 8px 0 0; font-size: 16px; color: var(--text); }
  .reader-empty p { margin: 0; }
  code { font-family: var(--mono); font-size: .92em; }

  @media (max-width: 1100px) {
    .segmented [data-appearance] span { display: none; }
  }

  @media (max-width: 760px) {
    .app { grid-template-columns: minmax(0, 1fr); }
    .reader { display: none; }
    .app.reading .sidebar { display: none; }
    .app.reading .reader { display: flex; }
    .back { display: inline-flex; }
    .letter-header { padding: 14px 16px 12px; }
    .toolbar { padding: 8px 12px; }
    .attachments { margin-left: 0; }
    [data-width-control] { display: none !important; }
  }
<% end %>
