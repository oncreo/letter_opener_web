<div class="app<%= ' reading' if params[:letter].present? && @letter %>"
     data-root="<%= letters_path %>"
     data-list-path="<%= letters_list_path %>"
     data-status-path="<%= letters_status_path %>"
     data-clear-path="<%= clear_letters_path %>"
     data-fingerprint="<%= LetterOpenerWeb::Letter.fingerprint %>">
  <aside class="sidebar" aria-label="Letters">
    <header class="sidebar-header">
      <div class="title">
        <%= lo_icon(:inbox, size: 18) %>
        <h1>Letters</h1>
        <span class="count" data-count><%= @letters.size %></span>
      </div>
      <div class="actions">
        <button type="button" class="icon-button" data-action="theme" title="Theme: system" aria-label="Change theme">
          <span data-theme-icon="system"><%= lo_icon(:system) %></span>
          <span data-theme-icon="light"><%= lo_icon(:sun) %></span>
          <span data-theme-icon="dark"><%= lo_icon(:moon) %></span>
        </button>
        <a href="<%= letters_path %>" class="icon-button" data-action="refresh" title="Refresh" aria-label="Refresh">
          <%= lo_icon(:refresh) %>
        </a>
        <%= form_tag clear_letters_path, method: :post, class: 'inline', data: { action: 'clear' } do %>
          <button type="submit" class="icon-button danger" title="Delete all letters" aria-label="Delete all letters">
            <%= lo_icon(:trash) %>
          </button>
        <% end %>
      </div>
    </header>
    <label class="search">
      <%= lo_icon(:search) %>
      <input type="search" placeholder="Search letters" aria-label="Search letters" data-search autocomplete="off">
      <kbd>/</kbd>
    </label>
    <div class="list" data-list>
      <%= render 'list', letters: @letters, selected: @letter %>
    </div>
  </aside>

  <main class="reader" data-reader>
    <% if @letter %>
      <%= render 'reader', letter: @letter %>
    <% else %>
      <%= render 'empty' %>
    <% end %>
  </main>
  <template data-empty-template><%= render 'empty' %></template>
</div>
